<mvc:View
    controllerName="ui5.claude.controller.ProductList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="productListPage" title="{i18n>viewProductListTitle}">
        <headerContent>
            <Button
                id="refreshButton"
                icon="sap-icon://refresh"
                tooltip="{i18n>viewProductListRefreshTooltip}"
                press=".onRefresh" />
        </headerContent>
        <subHeader>
            <Toolbar id="productListToolbar">
                <SearchField
                    id="productSearchField"
                    width="20rem"
                    placeholder="{i18n>viewProductListSearchPlaceholder}"
                    search=".onSearch" />
                <ToolbarSpacer />
                <Button
                    id="sortButton"
                    icon="sap-icon://sort"
                    tooltip="{i18n>viewProductListSortTooltip}"
                    press=".onSort" />
            </Toolbar>
        </subHeader>
        <content>
            <!-- Products list binding goes here -->
        </content>
    </Page>
</mvc:View>
