<mvc:View
    controllerName="ui5.claude.controller.ProductList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    displayBlock="true">
    <f:DynamicPage
        id="productListPage"
        fitContainer="true"
        headerExpanded="true"
        class="sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>viewProductListTitle}" />
                </f:heading>
                <f:actions>
                    <Button
                        id="refreshButton"
                        icon="sap-icon://refresh"
                        tooltip="{i18n>viewProductListRefreshTooltip}"
                        press=".onRefresh" />
                    <Button
                        id="sortButton"
                        icon="sap-icon://sort"
                        tooltip="{i18n>viewProductListSortTooltip}"
                        press=".onSort" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <OverflowToolbar id="productListToolbar">
                    <SearchField
                        id="productSearchField"
                        width="20rem"
                        placeholder="{i18n>viewProductListSearchPlaceholder}"
                        search=".onSearch" />
                </OverflowToolbar>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <List
                id="idProductsList"
                growing="true"
                growingThreshold="20"
                busyIndicatorDelay="0"
                noDataText="{i18n>viewProductListNoData}"
                items="{
                    path: 'northwind>/Products',
                    parameters: {
                        $select: 'ProductID,ProductName,UnitPrice,UnitsInStock'
                    },
                    events: {
                        dataRequested: '.onDataRequested',
                        dataReceived: '.onDataReceived'
                    }
                }">
                <items>
                    <ObjectListItem
                        id="idUnitPriceObjectListItem"
                        title="{northwind>ProductName}"
                        number="{northwind>UnitPrice}"
                        type="Navigation"
                        press=".onUnitPriceObjectListItemPress">
                        <attributes>
                            <ObjectAttribute
                                id="idUnitsInStockObjectAttribute"
                                text="{i18n>viewProductListLabelUnitsInStock}: {northwind>UnitsInStock}" />
                        </attributes>
                    </ObjectListItem>
                </items>
            </List>
        </f:content>
    </f:DynamicPage>
</mvc:View>
